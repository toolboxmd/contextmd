<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.toolboxmd.contextmd-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@DEPLOYED@/bin/contextmd-serve</string>
    <string>health</string>
    <string>--base</string>
    <string>@BASE@</string>
    <string>--gh</string>
    <string>@GH@</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@DEPLOYED@</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@LOGS@/contextmd-health.out.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/contextmd-health.err.log</string>
</dict>
</plist>
