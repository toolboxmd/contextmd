#!/bin/sh
# contextmd-hook <harness> <base-dir>: forward one harness hook event (stdin) to the
# Chromeria server that owns <base-dir>, print its reply, then settle.
#
# The server URL is the `origin` in Chromeria's own <base-dir>/userdata/server-runtime.json;
# the credential is a Chromeria bearer session `contextmd-serve install` stored in
# <base-dir>/userdata/contextmd/hook-credential. Fails open: with the off file, no
# server, no credential, a refused server, or one slower than the cut-off below, the harness
# call proceeds unserved
# and the agent sees nothing; an error status (an older server without the route, a 5xx)
# prints no body either (--fail). The settle call runs only after printf wrote all of the
# reply to stdout. The reply is held in the shell, not written by curl to /dev/fd: hosts
# that spawn hooks with socket stdio (Node on Linux) cannot reopen it there (#30).
harness=$1 base=$2
dir=$base/userdata/contextmd
[ -e "$dir/off" ] && exit 0
# Grok also runs Claude Code's settings.json hooks; its own hook file serves it (#32).
[ "$harness" = claude ] && [ -n "${GROK_HOOK_NAME:-}" ] && exit 0
url=$(sed -n 's/.*"origin" *: *"\([^"]*\)".*/\1/p' "$base/userdata/server-runtime.json" 2>/dev/null)
token=$(sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p' "$dir/hook-credential" 2>/dev/null)
[ -n "$url" ] && [ -n "$token" ] || exit 0
delivery=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
nl='
'
# The serving cut-off is 2 s, connect included, while Cue is new ("first we make it work,
# then we make it better"; user, 2026-10-13, chromeria#248); the faster aim is #248. Grok
# takes served text only at PreToolUse and allows its hooks 5 s, so it waits 4 s (#230).
deadline=2
[ "$harness" = grok ] && deadline=4
reply=$(curl -s --fail --connect-timeout 1 -m "$deadline" -w "$nl%{http_code}" \
  -H "authorization: Bearer $token" -H "x-contextmd-harness: $harness" -H "x-contextmd-delivery: $delivery" \
  -H 'content-type: application/json' --data-binary @- "$url/contextmd/v1/moment") || exit 0
[ "${reply##*$nl}" = 200 ] || exit 0
trap '' PIPE  # a closed stdout fails printf (no settle) instead of killing the hook
printf '%s' "${reply%$nl*}" 2>/dev/null || exit 0
exec 1>/dev/null
curl -s -m 0.3 -X POST -H "authorization: Bearer $token" "$url/contextmd/v1/settle/$delivery" >/dev/null 2>&1
exit 0
